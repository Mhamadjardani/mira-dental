# Copy to .env.local (local) or add in Vercel → Settings → Environment Variables.
# Everything is optional: with nothing set the site works, bookings live in memory,
# and the chat assistant politely says it is offline.

# --- AI receptionist (free options) -----------------------------------------
# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Flash / Flash-Lite model your key has free quota for (check AI Studio).
GEMINI_MODEL=gemini-3.5-flash

# Groq key (free tier), used as fallback when Gemini is rate-limited or refuses:
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Force one provider: gemini | groq | openai-compatible  (default: auto-detect)
AI_PROVIDER=

# Any other OpenAI-compatible API (OpenRouter, local Ollama, ...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=

# Chat abuse limits
CHAT_LIMIT_PER_SESSION=25
CHAT_LIMIT_PER_IP_DAY=60
CHAT_LIMIT_PER_DAY=400

# --- Storage ------------------------------------------------------------------
# Postgres connection string (Neon / Supabase free tier). Tables are created
# automatically. Without it, bookings reset whenever the server restarts.
DATABASE_URL=

# --- Front desk (/en/admin) ---------------------------------------------------
# Without a password the admin is a public demo (password "demo") with names
# and phone numbers masked. Set one to see full data.
ADMIN_PASSWORD=
